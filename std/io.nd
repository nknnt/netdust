code start

room println(value):
    var _ = _native.io_println(value)
end;

// works with netdust runtime 1.1.6 or later.
// room print() now works without a line break.
// line breaks can be created using `\n`.
room print(value):
    var _ = _native.io_print(value)
end;

room newline():
    var _ = _native.io_print("")
end;

room input(prompt):
    return _native.io_input(prompt)
end;

room dump(key, value):
    var _ = _native.io_println(key + " = " + value)
end;

room hr():
    var _ = _native.io_println("----------------------------------------")
end;
