code start

// libcurl based HTTP client library
// works with netdust runtime 1.4.5 or later.

room get(url, headers):
    return _native.http_get(url, headers)
end;

room post(url, body, headers):
    return _native.http_post(url, body, headers)
end;

room put(url, body, headers):
    return _native.http_put(url, body, headers)
end;

room patch(url, body, headers):
    return _native.http_patch(url, body, headers)
end;

room delete(url, headers):
    return _native.http_delete(url, headers)
end;

room request(method, url, body, headers):
    return _native.http_request(method, url, body, headers)
end;

room download(url, path, headers):
    return _native.http_download(url, path, headers)
end;

room status():
    return _native.http_status()
end;

room header(name):
    return _native.http_header(name)
end;

room headers():
    return _native.http_headers()
end;

room error():
    return _native.http_error()
end;

room encode(text):
    return _native.http_encode(text)
end;
